# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://billing:billing@localhost:5432/billing

# Stripe TEST MODE keys only — from https://dashboard.stripe.com/test/apikeys
# Never paste a live (sk_live_...) key here.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...

STRIPE_SUCCESS_URL=http://localhost:8000/billing/success
STRIPE_CANCEL_URL=http://localhost:8000/billing/cancel

ENVIRONMENT=development
